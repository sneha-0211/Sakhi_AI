# SAKHI AI Environment Configuration
APP_NAME="SAKHI AI"
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# CORS configuration (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,capacitor://localhost

# AI Engine Mode
# 'llm'        — Use Qwen3-8B via Hugging Face Inference API (recommended, real AI)
# 'rule_based' — Use deterministic rules only (no external API, fully offline)
AI_ENGINE_MODE=llm

# ─── Hugging Face / Qwen3-8B Settings ────────────────────────────────────────
# Required when AI_ENGINE_MODE=llm
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model to use (Qwen3-8B is recommended; must be accessible on HF Inference API)
QWEN3_MODEL_ID=Qwen/Qwen3-8B

# Generation parameters
QWEN3_MAX_TOKENS=512
QWEN3_TEMPERATURE=0.7

# ─── Legacy LLM Keys (unused when HF_TOKEN is set) ───────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Safety parameters
MAX_MESSAGE_LENGTH=1500
STRICT_SAFETY_FILTER=true
SESSION_TIMEOUT_MINUTES=60
